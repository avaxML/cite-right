    {
      "id": "claim_25d7b0eaeb4d49fb927d574e23b0cef8",
      "statement": "Cite-Right defines optional extras in `pyproject.toml`: `spacy` (`spacy>=3.7`, `click>=8.0`), `embeddings` (`sentence-transformers>=2.2`), `tiktoken` (`tiktoken>=0.5`), `huggingface` (`transformers>=4.30`, `tokenizers>=0.15`), `pysbd` (`pysbd>=0.3.4`), `langchain` (`langchain-core>=0.3.0`), and `llamaindex` (`llama-index-core>=0.11.0`). Extras can be combined by listing them with commas in a single `pip install` invocation.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L14-L21",
          "version": "repo-lines-v1:sha256:7e485f696d5aafbd50748264efc678cea8821390c68009d7ca1056fee3acd756:"
        }
      ]
    },
    {
      "id": "claim_96e5a54572c8475d9d29a6bd41460d00",
      "statement": "Installing the `spacy` extra does not include a language model; the small English model still has to be downloaded with `python -m spacy download en_core_web_sm` before spaCy-based segmenters and decomposers can run.",
