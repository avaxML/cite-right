    {
      "id": "claim_7f734e27a28048bd8fa9287689629b3b",
      "statement": "0.4.0 citation alignment is index-first: an inverted index over source passage windows plus rare-token intersect chooses which windows Smith-Waterman runs on, and Smith-Waterman still localizes the citation on those hits (plus optional embedding extras) — alignment does not run on every window or on every answer-span × window pair.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1180-L1232",
          "version": "repo-lines-v1:sha256:e18b9435c09451ad7703bcd6bb8063ffcc95e181a0304c3020ac77b65daa476b:"
