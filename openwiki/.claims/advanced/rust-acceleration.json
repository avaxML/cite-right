    {
      "id": "claim_348fd3855c3f4cc1af616b6718392571",
      "statement": "_default_aligner constructs RustSmithWatermanAligner first under backend=\"auto\" and falls back to SmithWatermanAligner on RuntimeError; backend=\"rust\" propagates the RuntimeError so the caller sees a missing or mismatched extension.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py",
          "version": "repo-file-v1:sha256:8bc512166b49a67657b8008597ee17295e27839a6006b1385a2e79e6028275f5"
