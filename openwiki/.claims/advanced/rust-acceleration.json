    {
      "id": "claim_4627500e37ad44efa5598e2efdff6938",
      "statement": "Rust prepare still runs with an embedder set when SimpleTokenizer and SimpleSegmenter are in use, so the embedding index is built on the Rust-prepared candidates; the 0.3.x skip of Rust prepare on the embedder path is gone.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/prepared_corpus.py",
