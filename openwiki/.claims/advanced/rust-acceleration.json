        }
      ]
    },
    {
      "id": "claim_c56209a5ec9b48a5aa19dca8e63e74c7",
      "statement": "PreparedCitationCorpus.from_sources takes the Rust prepare path only when use_rust=True (default), cite_right._core imports successfully, the tokenizer is a SimpleTokenizer, and the source segmenter is a SimpleSegmenter; a custom tokenizer or segmenter therefore runs the Python prepare path with inverted_index=None and rust_corpus=None, and a Rust-path failure rebuilds the corpus on the Python fallback with a sys.stderr message.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/prepared_corpus.py#L143-L156",
          "version": "repo-lines-v1:sha256:9af6ec24e05f32b3d67b04fe165b34f57c639676e83d860a8b37091e91dc50c9:"
        },
        {
