    {
      "id": "claim_97c663c819904c6e83706138b1a73eb8",
      "statement": "When cite_right._core is missing, the same PreparedCitationCorpus API still works, but _select_candidates uses _add_lexical_candidates directly (no conjunctive rare-token intersect), max_candidates_lexical is still the cap, and pure-Python SmithWatermanAligner handles alignment including return_match_blocks for multi-span.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py",
          "version": "repo-file-v1:sha256:8bc512166b49a67657b8008597ee17295e27839a6006b1385a2e79e6028275f5"
