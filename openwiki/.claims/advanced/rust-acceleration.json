    {
      "id": "claim_bdd136ee0dd1493c809f4a4342180383",
      "statement": "Cite-Right ships an optional native extension at cite_right._core that reimplements prepare, the inverted index, and Smith-Waterman alignment in Rust, published as abi3 wheels (abi3-py311) including linux/aarch64 plus an sdist; the extension and the Python package share the 0.5.0 version, so the public install path is pip install cite-right.",
      "evidence": [
        {
          "resource": "repo://rust_core/Cargo.toml#L1-L16",
          "version": "repo-lines-v1:sha256:14e7a563d53de5901bf8bfdcaed0d139ac5f5bc95be151d3ecc75cbc73f9cecf:"
        },
        {
