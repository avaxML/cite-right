    },
    {
      "id": "claim_5602d1a366bb4aea9813aaea6b6dceea",
      "statement": "With an embedder on the Rust path, lexical scores are filled only for inverted-index seeds, embedding-only extras keep lexical_score == 0.0, _add_embedding_candidates may add non-index windows before Smith-Waterman, those extras still need Smith-Waterman, and retrieval_support is not a Citation and does not flip status.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py",
          "version": "repo-file-v1:sha256:8bc512166b49a67657b8008597ee17295e27839a6006b1385a2e79e6028275f5"
        }
