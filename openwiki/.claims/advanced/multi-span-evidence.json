  "claims": [
    {
      "id": "claim_bd7cae6c11c54fcb9405c4680540eb31",
      "statement": "CitationConfig exposes a master switch multi_span_evidence (default False) and two tuning knobs multi_span_merge_gap_chars (default 16) and multi_span_max_spans (default 5) that control whether citations may return non-contiguous evidence regions.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L81-L83",
          "version": "repo-lines-v1:sha256:306e2cd0677b8d135125441bc3ecc45b48bc5649bb53c230fbb625a89f82b195:"
        }
      ]
    },
    {
      "id": "claim_24764af5bada4a60bd2509d944382b6d",
      "statement": "Multi-span evidence is a presentation layer on top of Smith-Waterman: the local aligner still produces one enclosing token_start/token_end window, and when constructed with return_match_blocks=True it additionally populates Alignment.match_blocks with disjoint exact-match regions that _alignment_to_evidence_spans converts into EvidenceSpan objects.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1384-L1425",
          "version": "repo-lines-v1:sha256:c7567b3d59a9f0f6a255aae6cb088daf92a0761002949afd30e0288064eaf59a:"
        },
        {
          "resource": "repo://src/cite_right/core/results.py#L64-L86",
          "version": "repo-lines-v1:sha256:cdf223752439a6ff7ae3cdc06ff472e96145e6193f32941bebbd6c84781d1f97:"
        }
      ]
    },
    {
      "id": "claim_46b496a7f335492e82e7f03c9da83a42",
      "statement": "_alignment_to_evidence_spans only emits the multi-span form when CitationConfig.multi_span_evidence is True AND the alignment has more than one disjoint match block; otherwise it falls back to a single enclosing span.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1384-L1438",
          "version": "repo-lines-v1:sha256:e24b0bbbf708fd00bfe8efd28baa0b934a32df62cd9799e054ba520d06aa090f:"
        }
      ]
    },
    {
      "id": "claim_10951f0175bb4f5cbb6b937b6abc6b1f",
      "statement": "_merge_evidence_spans combines adjacent evidence spans when the source-character gap between them is at most multi_span_merge_gap_chars; values <= 0 disable merging and every disjoint match stays as its own span. The merged list is sorted by (char_start, char_end) and the merged EvidenceSpan is re-sliced from the source.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1471-L1510",
          "version": "repo-lines-v1:sha256:5c4560863fdece012d60ff2972de0419abd9e58bf3aa0f6bdedfcfda86632258:"
        }
      ]
    },
    {
      "id": "claim_24a1e2e6eaa64954a8c5e4a1fd93aac6",
      "statement": "When the post-merge span count exceeds multi_span_max_spans, the citation falls back to a single contiguous enclosing span: evidence_spans becomes a one-element list equal to the enclosing evidence, and exact_evidence equals evidence. The status and overall citation are not dropped.",
      "evidence": [
        {
          "resource": "repo://rust_core/src/citation_fast.rs#L257-L295",
          "version": "repo-lines-v1:sha256:915405123c083a41d5e91fa959a1bda243e2fed25326223fe64c6776672deb5c:"
        },
        {
          "resource": "repo://src/cite_right/citations.py#L1405-L1425",
          "version": "repo-lines-v1:sha256:f6d87c26afc492d91a950871a49c08502f4efcf23a333ba29a6f7256fbebb41c:"
        }
      ]
    },
    {
      "id": "claim_cdeec974d0574b6e98bd5f66702615a3",
      "statement": "Citation.evidence_spans and Citation.exact_evidence are additive: the legacy char_start, char_end, and evidence stay a single contiguous enclosing slice so that source.text[citation.char_start:citation.char_end] == citation.evidence still holds, while the new fields expose individual matched regions and their \" ... \"-joined exact text.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/results.py#L212-L283",
          "version": "repo-lines-v1:sha256:bcc38446911239862623829b957c48de7f8913d48f84198f52290b1245742b36:"
        }
      ]
    },
    {
      "id": "claim_9a13034d610645d5ae82bc87e5c7aafa",
      "statement": "Citation.exact_evidence is a computed property: when evidence_spans is empty it returns evidence; otherwise it returns \" ... \".join(span.evidence for span in evidence_spans sorted by (char_start, char_end)).",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/results.py#L273-L283",
          "version": "repo-lines-v1:sha256:e87e658ce8a190ef803135cd013a1fe4a86f8294127cbde222a4034063aef025:"
        }
      ]
    },
    {
      "id": "claim_13700307ba8d4e03a0fd8730533a5294",
      "statement": "Each EvidenceSpan is a frozen Pydantic model with char_start (inclusive), char_end (exclusive), and evidence, where evidence is the source substring equal to source.text[char_start:char_end] after chunk rebasing. EvidenceSpan is exported from the public API.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/__init__.py#L113-L113",
          "version": "repo-lines-v1:sha256:068e044de9fbbd8fb3e10d63467363c9e8b8e0d4b1fb14d14a261bbe73770a32:"
        },
        {
          "resource": "repo://src/cite_right/__init__.py#L24-L24",
          "version": "repo-lines-v1:sha256:8d95360f20ca941bc328c8166eeac719dab09cb4f1204d148f28ed3271d2aa75:"
        },
        {
          "resource": "repo://src/cite_right/core/results.py#L193-L209",
          "version": "repo-lines-v1:sha256:b4a3300440530a0233852d228cf7038fd5893da48fd3e9dbd20d578b1297d6b8:"
        }
      ]
    },
    {
      "id": "claim_1eacd1fa5a984cbbb5d9c8e7623fffbc",
      "statement": "CitationConfig.multi_span_evidence drives whether the default aligner is constructed with return_match_blocks=True on every backend (Python, Rust, and the auto fallback), so the multi-span traceback only runs when the feature is on.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1105-L1135",
          "version": "repo-lines-v1:sha256:7643e5fb077d3df99c2310c24e87a7d597b65de1fd99f141e384e79df4f73ff6:"
        }
      ]
    },
    {
      "id": "claim_08e04e41ddc140ba8aaeb07c93fd9307",
      "statement": "The Rust backend raises at aligner construction time if the compiled extension does not expose the detailed match-block entry points (align_pair_blocks_details, align_batch_blocks_details) required to populate Alignment.match_blocks, so a stale extension cannot silently produce empty evidence_spans.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/aligner_rust.py#L50-L64",
          "version": "repo-lines-v1:sha256:993dfe13b4c77b7b83fdfe650d06ac20e3413b9043185ce84b5ff1d2a191b9bf:"
        }
      ]
    },
    {
      "id": "claim_aa9f7b740c584f86bcffc9d418742533",
      "statement": "The Python and Rust backends produce identical multi-span output: Python populates match_blocks through _consolidate_match_blocks on the detailed traceback in src/cite_right/core/aligner_py.py, and Rust populates them through smith_waterman_match_blocks / align_batch_with_match_blocks in rust_core/src/smith_waterman.rs.",
      "evidence": [
        {
          "resource": "repo://rust_core/src/lib.rs#L455-L498",
