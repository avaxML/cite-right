    },
    {
      "id": "claim_3fd9c7ffb61b423cbe21226e3e09c4ba",
      "statement": "Multi-span evidence respects SourceChunk offset rebasing: every EvidenceSpan.char_start and EvidenceSpan.char_end is in the parent document's coordinate system, sliced via _slice_source_text which uses source.full_text[abs_start:abs_end] when available and otherwise subtracts base_doc_offset from chunk-local text.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1376-L1381",
          "version": "repo-lines-v1:sha256:381a97f49f96a995bb156510a3acf6588642911cb50acaa6424525e376b57be7:"
        },
