    },
    {
      "id": "claim_f5bed61639a54f0a85a3a5bf2559beaa",
      "statement": "Rust prepare and the inverted index still run with multi_span_evidence=True on the default SimpleTokenizer + SimpleSegmenter path, and multi-span extraction is a per-alignment step that does not change the prepared corpus surface.",
