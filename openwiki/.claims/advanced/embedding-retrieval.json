  "claims": [
    {
      "id": "claim_f59742df1cb9477488ec482b165b2820",
      "statement": "Embedding retrieval is enabled by installing the `embeddings` extra with `pip install \"cite-right[embeddings]==0.4.0\"`, which pulls in `sentence-transformers>=2.2` and exposes `SentenceTransformerEmbedder` on the public surface.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L14-L17",
          "version": "repo-lines-v1:sha256:f2e26f1afc48232837e6e2bb8bb518adea546d520f38faa91505ea75c199945b:"
        },
        {
          "resource": "repo://src/cite_right/__init__.py#L61-L61",
          "version": "repo-lines-v1:sha256:45778d1f870b8e43b35ca4ef6954001b46cf3f5aea327fa69d17aeb75a3d0024:"
        }
      ]
    },
    {
      "id": "claim_8970ef10d5cf4a5d8f21d64421587202",
      "statement": "Candidate selection still starts from inverted-index seeds (or `rust_corpus.query_index` on the default Rust path), then `_add_embedding_candidates` can add non-index windows by querying the `EmbeddingIndex` with the answer-span vector, and every selected window still goes through Smith-Waterman alignment.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1180-L1354",
          "version": "repo-lines-v1:sha256:e5620c5b694172264e245bfca0513a87d2ce2c3c32acf629f6086c77977f16ce:"
        }
      ]
    },
    {
      "id": "claim_19234011cac84fb1a4f375ce74ac978c",
      "statement": "Rust prepare still runs when an embedder is set, provided the tokenizer and segmenter are `SimpleTokenizer` and `SimpleSegmenter`; the embedding index is then built on those prepared candidates. A custom tokenizer or segmenter forces the Python prepare path.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/prepared_corpus.py#L143-L292",
          "version": "repo-lines-v1:sha256:656cf8fb6cc607868f545c6ba8276f828d3d587ca63842d2a5f0f76600b56d09:"
        }
      ]
    },
    {
      "id": "claim_05fa7acaa1e14ced87af162a2e3b7c2a",
      "statement": "`retrieval_support` is exposed on `SpanCitations` and is not a `Citation`; it never flips `status`, so a passage that survived candidate selection but did not localize keeps the span at `\"unsupported\"`.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1553-L1568",
          "version": "repo-lines-v1:sha256:afc8f24be114b3b9984600846936361bea90408496d700308dd27aceb99099a1:"
