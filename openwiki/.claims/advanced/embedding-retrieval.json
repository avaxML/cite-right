          "resource": "repo://src/cite_right/core/results.py#L302-L348",
          "version": "repo-lines-v1:sha256:06e0230233700c5999dbcd6f7b08193939225cc097a8f7c967d351d762022fe5:"
        }
      ]
    },
    {
      "id": "claim_48c73975005d401b9c72207e7f0f2042",
      "statement": "Embedding-only `retrieval_support` entries still respect `min_embedding_similarity` (default 0.3); the check happens in `_build_retrieval_support_for_candidate` and rejects candidates whose `lexical_score <= 0.0` and `embed_score < cfg.min_embedding_similarity`.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L728-L746",
          "version": "repo-lines-v1:sha256:2a3b570b45f3bc8e990ec2dd73950e499c12a498a9444996ce7617d411a478d6:"
        },
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L60-L60",
          "version": "repo-lines-v1:sha256:9b9398fa6a00420be24d88f510ae63eab470e4c887b0b4f09ea9a2506ea118c8:"
        }
      ]
    },
    {
      "id": "claim_d54f9a679c684e738afaa3cd636d3379",
      "statement": "Lexical scores are filled only for inverted-index seeds; embedding-only extras keep `lexical_score == 0.0` so a weak embedding hit below `min_embedding_similarity` does not appear as retrieval support.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1211-L1219",
          "version": "repo-lines-v1:sha256:b2eebdea329a38b3e07d4b5d3cf0873c97218e3a691ab067ff58f1f50cd0aa0b:"
        },
