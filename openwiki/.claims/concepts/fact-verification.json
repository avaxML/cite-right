    {
      "id": "claim_25e2be1ecd124d3a8d41ca285ef18e1d",
      "statement": "verify_facts reuses the same citation-pipeline status semantics as align_citations: each per-claim call to align_citations returns a list of SpanCitations, the best Citation is picked by score, and its answer_coverage component is what determines the claim's \"verified\" / \"partial\" / \"unverified\" status, so embedding-only retrieval_support cannot flip a claim to \"verified\".",
      "evidence": [
