        }
      ]
    },
    {
      "id": "claim_f5ae5da6c05345a0aca46c23f251a875",
      "statement": "SpacyClaimDecomposer loads a spaCy model (default en_core_web_sm) and uses the dependency parse to find conj tokens; each conjunct is split into its own claim via the coordinating conjunction or the preceding comma or semicolon, with claim text below min_claim_tokens (default 2) dropped. When no conj tokens are found it falls back to a single Claim wrapping the whole span.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/claims.py#L160-L224",
          "version": "repo-lines-v1:sha256:a6ec4484d29dae3560b4e378bf4794212cafe8715de71896ce7b882853ff3599:"
        },
        {
          "resource": "repo://src/cite_right/claims.py#L226-L282",
          "version": "repo-lines-v1:sha256:6fb6cf091a74666ca2654eda2b63086d91a865693e0b43b927e4a692c8960d34:"
        },
        {
          "resource": "repo://src/cite_right/claims.py#L73-L158",
          "version": "repo-lines-v1:sha256:1156674f18c93cdcf656548b9b4246b3e2fd9d889ad506bf6adfa4dc45940bd1:"
        }
      ]
    },
    {
      "id": "claim_5e2cc6ca32104575af611527d3119b96",
      "statement": "SpacyClaimDecomposer requires the cite-right[spacy] extra and a downloaded spaCy model; construction raises RuntimeError with a clear message if spaCy is not importable or if the named model is not installed, and the default model needs `python -m spacy download en_core_web_sm`.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/claims.py#L91-L119",
          "version": "repo-lines-v1:sha256:661bd1ca9cb8d706c40469fef2a4fce56c5f0de8bee6cedc145aa74831faf569:"
        }
      ]
    },
    {
      "id": "claim_f37fd17b13964a0c951f98a4305ccff7",
      "statement": "ClaimDecomposer is a runtime-checkable Protocol in src/cite_right/claims.py with a single decompose(span: AnswerSpan) -> list[Claim] method, so any object implementing that signature can be passed as claim_decomposer to verify_facts, including custom LLM-based decomposers.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/claims.py#L36-L50",
          "version": "repo-lines-v1:sha256:dc98b7750a972046f121335e20286f4edbf2f3b04d93a230b7e3b1276420d669:"
        },
        {
