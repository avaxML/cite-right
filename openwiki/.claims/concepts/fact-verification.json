    {
      "id": "claim_8ad97907f5ed48b2b1853adb77825c21",
      "statement": "verify_facts accepts the same backend, source_segmenter, tokenizer, and embedder knobs as align_citations, with backend using the same \"auto\" | \"python\" | \"rust\" values and the same fallback semantics when cite_right._core is missing; each per-claim call to align_citations passes through backend, source_segmenter, tokenizer, and embedder unchanged.",
