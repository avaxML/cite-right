  "claims": [
    {
      "id": "claim_3d7ff36adba54f7899bd38168f21d86e",
      "statement": "verify_facts splits the answer into atomic claims and verifies each claim independently against the same sources that align_citations uses, producing per-claim verdicts and aggregate metrics so a mixed sentence does not hide which half is unsupported.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/claims.py#L36-L70",
          "version": "repo-lines-v1:sha256:fb9ecd2db87b56451bde96c34a8903099cd52d648f8417f99fd1786912b64971:"
        },
        {
          "resource": "repo://src/cite_right/fact_verification.py#L103-L140",
          "version": "repo-lines-v1:sha256:b3a0ec51de73d3561f5ebeef5512923c74e7ade1ca2fc726b9f7850494fdce27:"
        }
      ]
    },
    {
      "id": "claim_df7db4ce307549dd91c13f80456f19d6",
      "statement": "verify_facts runs a fixed control flow: segment the answer with the supplied AnswerSegmenter (default SimpleAnswerSegmenter), decompose each AnswerSpan into Claim objects via the supplied ClaimDecomposer (default SimpleClaimDecomposer), call align_citations on each claim.text against the sources, and fold the per-span results into ClaimVerification objects and an aggregate FactVerificationMetrics.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/fact_verification.py#L103-L151",
          "version": "repo-lines-v1:sha256:fa2769c314f9163fbe6a3767d3adfae6a3398f53f2a6a337c7f2bf89b7654bd0:"
        },
        {
          "resource": "repo://src/cite_right/fact_verification.py#L171-L217",
          "version": "repo-lines-v1:sha256:2d2bc506dd2442b6dedbabf49765543c898bc0a51ec21beeeafbbf305cb06d42:"
        },
        {
          "resource": "repo://src/cite_right/fact_verification.py#L236-L290",
          "version": "repo-lines-v1:sha256:7db46c412892e68636dc9ceb4a84454b52c13bf475358a403da1586ae7fe06ef:"
        }
      ]
    },
    {
      "id": "claim_d78aa29307274c3896ad8bdecfa7a8de",
      "statement": "SimpleClaimDecomposer is the default claim decomposer; it returns the input AnswerSpan as a single Claim with claim_index=0, has no extra dependencies, and matches sentence-level behavior when no further splitting is needed.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/claims.py#L53-L70",
          "version": "repo-lines-v1:sha256:01532e2f125f2c2911b3f974593df924aa4265a04fc7d47207b8780c963f9b3d:"
        },
        {
