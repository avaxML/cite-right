    },
    {
      "id": "claim_14cbc729591e4927a97874018296a0ac",
      "statement": "Index-first retrieval in 0.4.0 means an inverted index is built over source passage windows and a conjunctive rare-token intersect is used to pick candidate windows for each answer span, capped by max_candidates_lexical (default 200); Smith-Waterman still localizes the citation on the index hits — the index only chooses which windows to align, it does not skip alignment and it does not scan every window.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1180-L1232",
          "version": "repo-lines-v1:sha256:e18b9435c09451ad7703bcd6bb8063ffcc95e181a0304c3020ac77b65daa476b:"
        },
        {
