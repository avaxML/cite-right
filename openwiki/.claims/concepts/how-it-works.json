          "version": "repo-lines-v1:sha256:7572cd8e130133423267d6e56675e6de06ae6ded680af6b23a4e46bfa583abc9:"
        },
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L13-L22",
          "version": "repo-lines-v1:sha256:0bade5ed1896e483b3a1e7c175965eff90ec4a835545bf5e1100c104b9df759e:"
        }
      ]
    },
    {
      "id": "claim_558c709ce93742439a568ad263979f37",
      "statement": "Cite-Right is deterministic: given the same inputs and configuration it produces identical outputs across runs; the pure-Python SmithWatermanAligner is the reference implementation and the RustSmithWatermanAligner backend reproduces its behavior exactly, including tie-breaking order and floating-point rounding, with contract tests comparing the two backends for status, offsets, and evidence_spans.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1105-L1135",
          "version": "repo-lines-v1:sha256:7643e5fb077d3df99c2310c24e87a7d597b65de1fd99f141e384e79df4f73ff6:"
        }
      ]
    },
    {
      "id": "claim_5cf292c487584de18f3a2a0b4f126067",
      "statement": "Index-first retrieval makes candidate selection proportional to posting-list intersection on rare tokens rather than to answer_spans * passages, Smith-Waterman remains quadratic in the length of the sequences being aligned but only runs on index hits (plus optional embedding extras), and tokenization is linear in text length (SimpleTokenizer is a single pass); on the 50-case pack with no embedder 0.4.0 p50 wall time is about 12.4ms versus about 175.8ms in 0.3.1 (roughly 14×), spp is 81.3% versus 83.4%, RAGTruth test quality on 2,675 answers matched 0.3.1, and released wheels are abi3 (abi3-py311) including linux/aarch64 plus an sdist.",
      "evidence": [
