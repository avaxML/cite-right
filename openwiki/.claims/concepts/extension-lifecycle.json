    {
      "id": "claim_2be540289aa6486683b118ebe21c400d",
      "statement": "RustSmithWatermanAligner validates the extension at construction time, requiring align_pair_details and align_batch_details for standard use, and additionally align_pair_blocks_details and align_batch_blocks_details when return_match_blocks=True. Missing exports cause RuntimeError.",
