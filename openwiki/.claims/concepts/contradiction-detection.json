    {
      "id": "claim_3fa4493f8a1e41fb8a2226f14bc1f11e",
      "statement": "Contradiction detection is a post-alignment validation step that runs inside _span_status() after citations are ranked, downgrading span status to 'partial' (not 'unsupported') when evidence contradicts the answer claim.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1610-L1633",
          "version": "repo-lines-v1:sha256:0546591f2ac5ef2ec8353fa6d983babe6920c357814b4eae7d76a64a8120f7ff:"
        },
        {
