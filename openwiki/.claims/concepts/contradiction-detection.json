        }
      ]
    },
    {
      "id": "claim_c53d90def9584402911760fc80c3d3d8",
      "statement": "check_contradiction() runs five independent checks in sequence: has_negation_mismatch, has_number_mismatch, has_entity_swap, has_temporal_polarity_mismatch, and has_number_context_mismatch.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/contradiction.py#L67-L87",
          "version": "repo-lines-v1:sha256:1317147db28d1aec0bf8ab7b1fe33dc1ab584be40ba8f917e31c4eeb561b4dea:"
        }
      ]
    },
    {
      "id": "claim_3f6fd336948640bc9c54ca191c72588c",
      "statement": "has_negation_mismatch uses contains_negation() to search for negation patterns (not, n't contractions, no, neither, nor, cannot, never, etc.) and returns True when exactly one string contains negation.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/contradiction.py#L103-L144",
