    {
      "id": "claim_6d511deec79c4702b232f04e17fcef58",
      "statement": "has_number_mismatch extracts numbers via extract_numbers() (Unicode NFKC normalization), builds answer and evidence sets, and returns True only when every number in the answer is absent from evidence — meaning a shared number is not a mismatch.",
