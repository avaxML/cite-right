    {
      "id": "claim_456bba9e137c425089707756fe5d14f0",
      "statement": "has_entity_swap extracts capitalized words (excluding _FUNCTION_WORDS and _SENTENCE_START_STOPWORDS), returns True when both strings have entities and each contains unique entities absent from the other.",
