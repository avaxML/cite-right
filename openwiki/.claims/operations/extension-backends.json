          "resource": "repo://src/cite_right/citations.py#L77-L77",
          "version": "repo-lines-v1:sha256:17e573fffa9a11b7697328b7c2e7449a4330a731efb724309b5d493bd39be792:"
        }
      ]
    },
    {
      "id": "claim_329fb4014a774ea19e7bc4622af4e46c",
      "statement": "_default_aligner in src/cite_right/citations.py resolves the active Aligner by branching on backend: 'python' returns SmithWatermanAligner, 'rust' attempts RustSmithWatermanAligner (raising on failure), and 'auto' wraps the Rust attempt in try/except RuntimeError and falls back to SmithWatermanAligner.",
      "evidence": [
