    {
      "id": "claim_1ca0adc9cab44744b3c9bb3d26edd8e6",
      "statement": "The backend parameter accepts three literal values: 'auto' (default) attempts Rust and silently falls back to Python; 'python' forces the pure-Python aligner; 'rust' requires Rust and raises RuntimeError if unavailable or incomplete.",
      "evidence": [
