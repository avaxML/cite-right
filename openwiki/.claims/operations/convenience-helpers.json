    {
      "id": "claim_884e06f72b0f462fa54ba5545c6c5a8d",
      "statement": "format_with_citations() accepts pre-computed SpanCitations results and inserts citation markers. It supports three format styles: 'markdown' ([n] default), 'superscript' (^n), and 'footnote' ([^n]).",
