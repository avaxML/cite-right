    {
      "id": "claim_fb098a56fbaa4015b73dbf19b3325c58",
      "statement": "HallucinationConfig has two knobs: weak_citation_threshold (default 0.4) controlling which spans are flagged as weakly supported, and include_partial_in_grounded (default True) controlling whether partial-status spans count toward groundedness_score.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/hallucination.py#L16-L30",
          "version": "repo-lines-v1:sha256:461a53040bbb9561793cabf2e5437fe19267fa71bd094e9bdb3e7e7188c8cbfd:"
        }
      ]
    },
    {
      "id": "claim_cc4dc6f7069d43a3ad21943f98566670",
      "statement": "groundedness_score is computed as weighted_confidence_sum / total_chars, where weighted_confidence_sum accumulates confidence * span_len only for grounded spans (supported always, partial conditionally), and total_chars is the sum of all span lengths.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/hallucination.py#L146-L234",
          "version": "repo-lines-v1:sha256:32a18c7be47c07a41835bffac094b49756a758b47499275be161ca9f4049aba7:"
        }
      ]
    },
    {
