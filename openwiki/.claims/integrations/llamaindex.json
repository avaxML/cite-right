    {
      "id": "claim_dd8f2b581f514a6e88a3cae7b3253d85",
      "statement": "The LlamaIndex integration lives in src/cite_right/integrations.py and exposes two adapter functions: from_llamaindex_nodes (TextNode / NodeWithScore → SourceDocument) and from_llamaindex_chunks (TextNode / NodeWithScore with offset metadata → SourceChunk). Both are re-exported from the top-level cite_right package.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/__init__.py#L44-L60",
          "version": "repo-lines-v1:sha256:3b9af0f99132e1bddbd2da59235deeb0de3d8ba3f340bf31b3f48b94dea4cdc3:"
        },
        {
