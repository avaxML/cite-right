          "version": "repo-lines-v1:sha256:758cb987e31d07e1388d08087e4b14c0c58f647d695140df0e5e382e4beaf90b:"
        }
      ]
    },
    {
      "id": "claim_b7ed94f0e56044ddb5656c849e9637ff",
      "statement": "The llama-index integration is opt-in via the cite-right[llamaindex] pip extra, which depends on llama-index-core>=0.11.0 declared in pyproject.toml.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L20-L21",
