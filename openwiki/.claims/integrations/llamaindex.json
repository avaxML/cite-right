    },
    {
      "id": "claim_1d416879b8bf488f916ace4e01692cc7",
      "statement": "If llama-index-core is not installed, the module-level LLAMAINDEX_AVAILABLE flag is False, LlamaIndexTextNode / LlamaIndexNodeWithScore / LlamaIndexNode resolve to None, and both adapter functions raise ImportError via _require_llamaindex() with the install hint. The is_llamaindex_available() helper and the is_llamaindex_node(obj) type guard are exposed for boundary checks.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L115-L135",
          "version": "repo-lines-v1:sha256:25fc0bd7fd8352e6124fa461ca38552e3f1f185e82dd23668f9a4150fda856c9:"
        },
        {
          "resource": "repo://src/cite_right/integrations.py#L19-L43",
          "version": "repo-lines-v1:sha256:34c9ac6eb647d88b28e4fdcdbb776fa9a207bd47330eba941fcdd2de2278dee4:"
        },
        {
          "resource": "repo://src/cite_right/integrations.py#L55-L91",
          "version": "repo-lines-v1:sha256:064379c3e05bb67ea44a19ff90fbdeecdbb7fd6014ebd354a1383961e2b607bb:"
        }
      ]
    },
    {
      "id": "claim_59773e19bb6a4ca58b5ce56be16b3628",
      "statement": "from_llamaindex_nodes(nodes, *, id_key=\"file_name\") accepts a sequence of TextNode or NodeWithScore, unwraps NodeWithScore via getattr(node, \"node\", node), reads text from actual_node.get_content(), copies the metadata dict through unchanged, and derives the SourceDocument id from metadata[id_key] falling back to str(idx). The default id_key=\"file_name\" matches the metadata convention written by SimpleDirectoryReader and most LlamaIndex text splitters.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L242-L284",
          "version": "repo-lines-v1:sha256:b928d50699b060566f5c620a61d46722d35339d1870ed9cd6bb96287a66e3d59:"
        }
      ]
    },
    {
      "id": "claim_31ad7a2087744672b9ae3bff5a80b352",
      "statement": "from_llamaindex_chunks(nodes, *, id_key=\"file_name\", start_key=\"start_char_idx\", end_key=\"end_char_idx\") accepts a sequence of LlamaIndex nodes with offset metadata, unwraps NodeWithScore, reads start and end offsets from metadata[start_key] / metadata[end_key] (falling back to 0 and start + len(content) when missing), and produces SourceChunk objects whose doc_char_start and doc_char_end point at the parent document so citation offsets rebase onto the original. The adapter does not set document_text because LlamaIndex nodes do not always carry the full parent text.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L287-L342",
          "version": "repo-lines-v1:sha256:54cafe5a5dc29816c9f9c564f5ee266e605d8e5aa61f8cf0de44319934bf98da:"
        }
      ]
    },
    {
      "id": "claim_008f11b6f84d4d49bd967d2fa46bab6e",
      "statement": "The LlamaIndex adapters do not copy the retrieval score from a NodeWithScore wrapper into the resulting SourceDocument. The unwrap reads content and metadata from the inner node but discards the score attribute. Retrieval scores must be copied into metadata by the application if they need to round-trip to the citation payload.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L270-L284",
          "version": "repo-lines-v1:sha256:599e163454836b7d562d92cbff2eccdb8581ad27cbd5c57655e7c3deab75a47e:"
        },
        {
          "resource": "repo://src/cite_right/integrations.py#L322-L342",
          "version": "repo-lines-v1:sha256:85f5ccd11603e44c12a8d581a1a15fc5388c73ca3e8d8e307d0ed68e02c3ca68:"
        }
      ]
    },
    {
      "id": "claim_27a6166b78314b6bacb721b0afb9afe5",
      "statement": "SourceDocument.metadata and SourceChunk.metadata are opaque to the alignment pipeline. Cite-Right does not index them, does not score on them, and does not surface them on Citation or SpanCitations; they are the application's handle for round-tripping retrieval scores, file paths, and page numbers back to the user.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L270-L284",
          "version": "repo-lines-v1:sha256:599e163454836b7d562d92cbff2eccdb8581ad27cbd5c57655e7c3deab75a47e:"
        },
        {
