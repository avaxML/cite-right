  "claims": [
    {
      "id": "claim_e3458ae7c8724b688c0c14e036660496",
      "statement": "The LangChain integration is gated by the optional `langchain-core>=0.3.0` extra, installable with `pip install \"cite-right[langchain]==0.4.0\"`; if the import fails, the module-level `LANGCHAIN_AVAILABLE` flag is `False` and `from_langchain_documents` / `from_langchain_chunks` raise `ImportError` via `_require_langchain()`.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L14-L21",
          "version": "repo-lines-v1:sha256:7e485f696d5aafbd50748264efc678cea8821390c68009d7ca1056fee3acd756:"
        },
        {
          "resource": "repo://src/cite_right/integrations.py#L18-L52",
          "version": "repo-lines-v1:sha256:7569d030e3ab75e7ea9d3166067d0e4f1c890c62f0ee256bbe792fa504b2ac63:"
        }
      ]
    },
    {
      "id": "claim_73ef6aa8c902461ab63e127c761dc581",
      "statement": "`from_langchain_documents(documents, *, id_key=\"source\")` converts LangChain `Document` objects to `SourceDocument` by reading `doc.metadata[id_key]` for the document id (falling back to `str(idx)` when missing) and copying `doc.metadata` and `doc.page_content` onto the result.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/integrations.py#L138-L180",
          "version": "repo-lines-v1:sha256:30b8e9dfdbc2c82f4d51b5f490a946aae28f2996dcee9b0a6eb4175e13e63d00:"
        }
      ]
    },
    {
      "id": "claim_bf26c26364d745ccbee0c2a63d8bd032",
      "statement": "`from_langchain_chunks(documents, *, id_key=\"source\", start_key=\"start_index\", end_key=\"end_index\", full_text_key=None)` converts pre-chunked LangChain `Document` objects to `SourceChunk`, reading the chunk's parent-document offsets from `start_key` / `end_key` (defaulting to `0` and `start + len(page_content)`), and optionally forwarding a parent text from `full_text_key` as `document_text` for slice validation.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/results.py#L111-L162",
          "version": "repo-lines-v1:sha256:af562243ab05fb1a0ca7bdfbd1bb27de39bf7e78d2b5353e48125ef2070f3231:"
        },
        {
          "resource": "repo://src/cite_right/integrations.py#L183-L239",
          "version": "repo-lines-v1:sha256:be4992f94e7d46ce0a8e9f67c8763c996aa6521fc3ca02143ee6e1127bcccd54:"
        }
      ]
    },
    {
      "id": "claim_d765b58e40954035aaa4c125d30b3f07",
      "statement": "Source chunks produced by `from_langchain_chunks` participate in the same rebase contract as hand-built `SourceChunk`s: `SourceChunk.doc_char_start` is stored on `NormalizedSource.base_doc_offset`, every resulting `Citation.char_start` / `char_end` is absolute in the parent, and the evidence equality invariant `source.text[citation.char_start:citation.char_end] == citation.evidence` holds whether or not `document_text` is supplied.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1376-L1382",
          "version": "repo-lines-v1:sha256:eaf9fe4b8419d12fda75f5962f221453d31edb1817144b49559aea99ca20e90e:"
        },
        {
          "resource": "repo://src/cite_right/core/prepared_corpus.py#L405-L435",
          "version": "repo-lines-v1:sha256:0cd8f97a4665a71025d29ce4bc8bdd11ab9158c24464e2a30d8fdb31ff8917f8:"
        }
      ]
    },
    {
      "id": "claim_801725e41f6c47cc898203838cb5a73f",
      "statement": "`is_langchain_available()` reports whether `langchain_core` could be imported at module load, and `is_langchain_document(obj)` is the runtime type guard for retriever outputs (returns `False` for plain dicts or strings even when they expose `page_content`).",
      "evidence": [
