    {
      "id": "claim_709e882d07814788a8e63ce57acebc7f",
      "statement": "The adapters are export surfaces, not pipeline entry points: the conversion stops at `SourceDocument` / `SourceChunk`, and all alignment, indexing, candidate selection, and status determination happens inside `align_citations` on the same path used for hand-built sources.",
