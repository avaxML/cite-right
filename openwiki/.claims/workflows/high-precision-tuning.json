    },
    {
      "id": "claim_f401f22fb6464b158e2f1923c87cd196",
      "statement": "multi_span_evidence settings (multi_span_evidence, multi_span_merge_gap_chars, multi_span_max_spans) control non-contiguous evidence extraction. When multi_span_evidence=True and alignment produces disjoint match blocks, the pipeline extracts separate EvidenceSpan objects; merging and max-span limits apply. For high-precision use cases, keeping multi_span_evidence=False is recommended for simpler output and reduced offset error surface.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1384-L1423",
          "version": "repo-lines-v1:sha256:176ecbc6091cac2a69d1e8ea04d459ca14bbe71012a63ca61e09ff6a5944cf8b:"
        }
      ]
    },
    {
      "id": "claim_1a193279f98e495abb035bd63a3cf96b",
      "statement": "test_strict_exact_citation_rejects_numeric_token_mismatch() demonstrates that '125 days' vs '124 days' produces unsupported status with the high-precision config, and test_strict_exact_citation_rejects_negation_token_mismatch() demonstrates that 'shall make every' vs 'shall make no' is rejected when require_all_answer_tokens_in_evidence=True.",
