    {
      "id": "claim_393b653e57ed435cb8b9818789c66d92",
      "statement": "min_answer_coverage and min_final_score are not redundant: coverage controls what fraction of the answer must be present, while min_final_score controls the overall composite quality gate. Lower min_answer_coverage improves recall; raise min_final_score improves precision.",
