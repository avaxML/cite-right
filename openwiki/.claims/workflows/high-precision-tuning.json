  "claims": [
    {
      "id": "claim_9f3113e5570c48a6ac576c88eae90a10",
      "statement": "The benchmarked high-precision configuration combines CitationWeights(alignment=1.0, answer_coverage=1.0, evidence_coverage=0.0, lexical=0.5, embedding=0.5) with CitationConfig(min_answer_coverage=0.4, supported_answer_coverage=0.6, min_final_score=2.6, top_k=1). It was derived via multi-dimensional grid search over an adversarial RAG dataset.",
      "evidence": [
        {
          "resource": "repo://README.md#L108-L136",
          "version": "repo-lines-v1:sha256:5943d6c9dfaed3514c9b3c97ee5d82498516851c8b7582e25bfafb5afd8b59a0:"
        }
      ]
    },
    {
      "id": "claim_7ddc1488f0264fbcae00ba2234cc6e5d",
      "statement": "min_final_score is the most impactful precision knob because it gates the composite weighted score after all individual signals (alignment, coverage, lexical, embedding) have been computed. With the high-precision weights, the theoretical maximum score is 3.0; setting min_final_score=2.6 requires ~87% of that maximum, eliminating near-miss paraphrases, embedding-only matches, and partial numeric mismatches.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L808-L821",
          "version": "repo-lines-v1:sha256:deb6b66ede4dfed1022481cea9c62b7d2836d8634ca663e0c0a63dcf9059d82a:"
        }
      ]
    },
    {
      "id": "claim_1f0d76c02d8e424ca6690c4303f2059f",
      "statement": "The composite score formula in _compute_final_score() is: weights.alignment * normalized_alignment + weights.answer_coverage * answer_coverage + weights.evidence_coverage * evidence_coverage + weights.lexical * lexical_score + weights.embedding * max(0.0, embed_score). Weights are summed directly and are not normalized, so absolute values affect the score scale.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L808-L821",
          "version": "repo-lines-v1:sha256:deb6b66ede4dfed1022481cea9c62b7d2836d8634ca663e0c0a63dcf9059d82a:"
        }
      ]
    },
    {
      "id": "claim_cfb56bb46fc244a69bf09e61242f9cc2",
      "statement": "min_answer_coverage controls the minimum fraction of answer tokens that must appear in aligned evidence; raising it from the default 0.2 to 0.4 rejects citations with significant paraphrasing. supported_answer_coverage is the threshold for supported status: coverage >= supported_answer_coverage -> supported; below -> partial.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L785-L805",
          "version": "repo-lines-v1:sha256:b2d994ba7eb8cb1b5340067c352cb856502f3133365828f8727e5d51dd237309:"
        }
      ]
    },
    {
      "id": "claim_32ed00c7b5ac4c66ab7d054087646f3c",
      "statement": "_span_status() (repo://src/cite_right/citations.py#L1610-L1633) returns 'unsupported' when there are no citations, 'partial' when a contradiction is detected or coverage < supported_answer_coverage, and 'supported' only when coverage >= supported_answer_coverage and no contradiction exists.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1610-L1633",
          "version": "repo-lines-v1:sha256:0546591f2ac5ef2ec8353fa6d983babe6920c357814b4eae7d76a64a8120f7ff:"
        }
      ]
    },
    {
      "id": "claim_df4dec4a4f474bf8a9d77c4d26392ce3",
      "statement": "require_all_answer_tokens_in_evidence=True forces every answer token to appear in aligned evidence via _answer_tokens_match_evidence(), catching negation flips and numeric mismatches that min_final_score alone might miss. It is used by CitationConfig.strict() but not the README high-precision recipe.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L699-L708",
          "version": "repo-lines-v1:sha256:6b8bcad04cb957ad0070134a566da18df7872aded17189f7f9911de5d163b3a2:"
        }
      ]
    },
    {
      "id": "claim_834bcf59cd074c2982cc4023b6e85002",
      "statement": "CitationConfig.strict() and the README high-precision recipe differ in three key ways: strict() sets require_all_answer_tokens_in_evidence=True, uses supported_answer_coverage=0.7, and min_final_score=0.3; the README recipe sets require_all_answer_tokens_in_evidence=False, uses supported_answer_coverage=0.6, and min_final_score=2.6.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L100-L126",
          "version": "repo-lines-v1:sha256:d53bc121a82dbb137fdb4d1f675eeb0a571bafb41e53e0163365cbcb53652895:"
        }
      ]
    },
    {
      "id": "claim_10b50f72b0f441c9a7e0a572fbca98d6",
      "statement": "check_contradiction() implements five contradiction checks: negation mismatch, number mismatch, entity swap, temporal/polarity mismatch, and number context mismatch. Contradiction detection runs in _span_status() against the full candidate passage (not truncated alignment evidence) via _contradiction_context().",
      "evidence": [
        {
          "resource": "repo://src/cite_right/contradiction.py#L67-L87",
          "version": "repo-lines-v1:sha256:1317147db28d1aec0bf8ab7b1fe33dc1ab584be40ba8f917e31c4eeb561b4dea:"
        }
      ]
    },
    {
      "id": "claim_dedcec42ec2c421a9aaa4386f87933c8",
      "statement": "When contradiction is detected, _span_status() returns 'partial' rather than 'unsupported' to retain the citation for transparency, allowing downstream consumers to surface the contradicting passage.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/citations.py#L1621-L1629",
          "version": "repo-lines-v1:sha256:2e9e3279555e5f17068c5d36ccadfd794649f9dcfc19e39da1ec5fedf8aaace5:"
