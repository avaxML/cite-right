    {
      "id": "claim_91bcebf6a1c24c39a41c39cb3d896f17",
      "statement": "Evidence span absolute offsets are computed as base_doc_offset + passage.doc_char_start + local_seg_char_offset. This produces offsets in the original document coordinate system for all three input types.",
