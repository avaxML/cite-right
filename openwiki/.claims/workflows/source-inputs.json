    {
      "id": "claim_28f779f8d45542b088716f3dbd35f1d3",
      "statement": "SourceChunk._validate_document_text_alignment enforces three checks when document_text is supplied: (1) doc_char_start >= 0 and doc_char_end >= doc_char_start, (2) doc_char_end <= len(document_text), (3) document_text[doc_char_start:doc_char_end] == text. It raises ValueError on any violation.",
      "evidence": [
        {
