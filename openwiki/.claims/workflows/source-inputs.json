          "version": "repo-lines-v1:sha256:e57c7155059681641ddc8894355a3389018d4689ff0fa90f8df83b150d398408:"
        }
      ]
    },
    {
      "id": "claim_c0a4f481916740ee8ee0e266716d62f0",
      "statement": "_slice_source_text() uses full_text directly when available (full_text[abs_start:abs_end]), otherwise subtracts base_doc_offset to re-base absolute offsets to local chunk coordinates (text[local_start:local_end]).",
      "evidence": [
