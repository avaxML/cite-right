    },
    {
      "id": "claim_ee28b4bdef1d4857abc60dc0b1f871e0",
      "statement": "SpacyClaimDecomposer decomposes compound sentences at conjunction boundaries, enabling independent verification of each clause. For example, 'Revenue grew and profits increased.' splits into 'Revenue grew' and 'profits increased'.",
      "evidence": [
