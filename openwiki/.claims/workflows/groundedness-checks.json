  "claims": [
    {
      "id": "claim_2177fe5544ad464e94736a62da8dec50",
      "statement": "Groundedness checking in cite-right operates at two distinct levels: span-level (is_grounded, is_hallucinated, check_groundedness) evaluates whole answer segments, while claim-level (verify_facts) decomposes answers into atomic claims and verifies each independently.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/convenience.py#L23-L173",
          "version": "repo-lines-v1:sha256:4b31aa4c7901d91c430b9a2085ee1157397f0364ce8e6c52972c42eae23c28bd:"
        },
        {
          "resource": "repo://src/cite_right/fact_verification.py#L103-L140",
          "version": "repo-lines-v1:sha256:b3a0ec51de73d3561f5ebeef5512923c74e7ade1ca2fc726b9f7850494fdce27:"
        }
      ]
    },
    {
      "id": "claim_08c0f5ebaf254ef38d5bb6c2393240a9",
      "statement": "is_grounded() and is_hallucinated() share the same default threshold of 0.5, meaning at least 50% of the answer (by character count) must be grounded. They are complementary inverses where is_grounded(t) equals not is_hallucinated(t).",
      "evidence": [
        {
          "resource": "repo://src/cite_right/convenience.py#L23-L120",
          "version": "repo-lines-v1:sha256:ce22015e65e61d75315afffbb337672461500589ae6f440eec62572231f7224c:"
        }
      ]
    },
    {
      "id": "claim_fb754957c2f44df98293e1a404d288ef",
      "statement": "HallucinationMetrics provides groundedness_score (length-weighted average of per-span confidence), hallucination_rate (always 1.0 - groundedness_score), ratio fields (supported/partial/unsupported by character count), and unsupported_spans list.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/hallucination.py#L57-L103",
          "version": "repo-lines-v1:sha256:d5c21fc1e64820fcfa78e94d7fdc3b931499dc5945a17edb7370247ce0168551:"
        }
      ]
    },
    {
      "id": "claim_5ca695205eff49beb22a4d7ed9d59645",
      "statement": "Span status is determined by the best citation's answer_coverage component: supported when coverage >= 0.6, partial when 0.0 < coverage < 0.6, and unsupported when no citations exist or coverage equals 0.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/hallucination.py#L214-L229",
          "version": "repo-lines-v1:sha256:3a222acc63d01d0024c7472adf60dfd18cc833a191d46bb698811a05fdeb301a:"
        }
      ]
    },
    {
      "id": "claim_dc13a37207954ffcbc2750ce117dd723",
      "statement": "For each span, confidence is extracted from the citation's answer_coverage component, meaning semantic-only citations with no lexical match contribute 0.0 to the groundedness score even if the citation score is high.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/hallucination.py#L189-L207",
          "version": "repo-lines-v1:sha256:d8aeb1e40211891f842af017903191a277fa7ce51da92b5e1367bf8d79144379:"
        }
      ]
    },
    {
      "id": "claim_a677147d624f4f3080ee793731acd4cb",
      "statement": "FactVerificationConfig uses explicit coverage thresholds: verified_coverage_threshold=0.6 (>= 60% coverage) and partial_coverage_threshold=0.3 (>= 30% coverage for partial, below is unverified).",
      "evidence": [
        {
          "resource": "repo://src/cite_right/fact_verification.py#L27-L43",
          "version": "repo-lines-v1:sha256:e56abac4c0d00136af708ffad26c69b48d1ad0cdb048815989213d9416c5c766:"
        }
