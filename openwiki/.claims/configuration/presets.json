          "resource": "repo://src/cite_right/core/citation_config.py#L128-L155",
          "version": "repo-lines-v1:sha256:f6aba99e218b5c4e0c766b722171c22d54b9eb152827057b61d4fa72aa6894a9:"
        }
      ]
    },
    {
      "id": "claim_2bb5f9a183e2417f8f1ecfdd1f818089",
      "statement": "CitationConfig.permissive() does not change the requirement that emitted Citation objects carry Smith-Waterman-localized char_start/char_end evidence; the lower thresholds let more candidates through, but every surviving candidate still goes through the same alignment step.",
