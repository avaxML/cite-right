    {
      "id": "claim_e276ff9ee6774bf29eec5cf54a762b54",
      "statement": "CitationConfig exposes four preset class methods in src/cite_right/core/citation_config.py: balanced(), strict(), permissive(), and fast(); CitationConfig.balanced() returns the same configuration as the default CitationConfig() constructor.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L99-L198",
          "version": "repo-lines-v1:sha256:52447c725b8f738a8dc05b80542be95495f09ba2c85ace76200393eb239fe582:"
        }
      ]
    },
    {
      "id": "claim_5e034edf6f204855b7ff2b849bdf3a29",
      "statement": "CitationConfig.strict() tightens precision by setting top_k=2, min_answer_coverage=0.4, supported_answer_coverage=0.7, min_final_score=0.3, max_citations_per_source=1, max_retrieval_support=2, and require_all_answer_tokens_in_evidence=True; it does not change the candidate caps or the embedder similarity threshold.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L99-L126",
          "version": "repo-lines-v1:sha256:a95d6143cada5ea1360d0f4f967d77ccd528ee86f94b407214a3463ec9f9eb20:"
        }
      ]
    },
    {
      "id": "claim_ed1bac9fdb914e348651a08bbb797ddb",
      "statement": "CitationConfig.permissive() widens recall by setting top_k=5, min_answer_coverage=0.15, supported_answer_coverage=0.4, min_embedding_similarity=0.25, max_citations_per_source=3, and max_retrieval_support=5; it leaves min_final_score at 0.0 and does not change the candidate caps.",
      "evidence": [
