          "version": "repo-lines-v1:sha256:fa3b8be3dee68223427f724ccbbb570a6215dd6f102ef05bc63772cc27b481c5:"
        },
        {
          "resource": "repo://src/cite_right/core/citation_config.py#L53-L73",
