  "claims": [
    {
      "id": "claim_75a4f499832a4683b52ab9bc26418e8d",
      "statement": "CitationConfig is a frozen Pydantic model in src/cite_right/core/citation_config.py, exported as part of the public API via `from cite_right import CitationConfig` and passed to `align_citations(answer, sources, *, config=...)` and `PreparedCitationCorpus.from_sources(sources, config=...)`. CitationWeights is its companion frozen Pydantic model.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/__init__.py#L20-L20",
          "version": "repo-lines-v1:sha256:b7f601160ae31d4c993866569739f997b633141484d40ad58062bb906642f6bb:"
        },
        {
          "resource": "repo://src/cite_right/citations.py#L72-L84",
          "version": "repo-lines-v1:sha256:18dedc5b5bc251eef675a9aa4d72e4e67b19c3586b8cc7f13251ff4d2e6d7a84:"
        },
