    {
      "id": "claim_41d10d93625f4846bca5e04315f3a71d",
      "statement": "SimpleSegmenter is a rule-based sentence splitter that cuts on '.', '?', or '!' when followed by whitespace, on ';', and on '\\n' when split_on_newlines=True; it recognizes a small abbreviation list and any single-letter initial pattern, and requires no model.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/text/segmenter_simple.py#L12-L74",
          "version": "repo-lines-v1:sha256:896499380d2938cbcfb03aa98315d8eadc433a32c6f8601dc482001667171009:"
        }
      ]
    },
    {
      "id": "claim_e5f24243415e47f99daceab1f44f213a",
      "statement": "SimpleAnswerSegmenter splits the answer into paragraphs on two-or-more consecutive line breaks, then runs SimpleSegmenter(split_on_newlines=False) per paragraph and emits AnswerSpan objects with kind=\"sentence\", paragraph_index, and a global sentence_index.",
      "evidence": [
        {
          "resource": "repo://src/cite_right/text/answer_segmenter.py#L11-L92",
          "version": "repo-lines-v1:sha256:e7ea6d0794224c3e650704fa2413f8a28aa410ab32d57c5eb465cd8f22fd25af:"
        }
      ]
    },
    {
