    {
      "id": "claim_00bc3c6431b94a3282cd61ef19f090b3",
      "statement": "rust_corpus.query_index implements a conjunctive (AND) query that sorts tokens by rarity (ascending posting count), intersects from the rarest token outward, and OR-expands when intersection is tiny or candidate count is below 32.",
      "evidence": [
        {
          "resource": "repo://rust_core/src/inverted_index.rs#L75-L148",
          "version": "repo-lines-v1:sha256:0b84980f4a46644e515ac8d7f55afb20d302d69dd6c614634e2d7bab5f7bd7c7:"
        }
      ]
    },
    {
      "id": "claim_e1ce0c16271d40369b3ed628f5d28cc3",
      "statement": "When the index returns no candidates, _add_lexical_candidates computes IDF-weighted overlap scores across all candidates and takes the top max_candidates_lexical entries.",
