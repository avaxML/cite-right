    {
      "id": "claim_37e40375fc064778aa0ef496b37c526e",
      "statement": "_select_candidates follows strict stage ordering: index seeding (rust_corpus.query_index preferred, then inverted_index.query), then lexical fallback, then embedding top-k. Each stage is independently gated and can add new candidates to the merged set.",
